{
  "openapi": "3.1.1",
  "info": {
    "title": "Veti - Sistema de Acompanhamento Clínico de Pets",
    "description": " Esta é a documentação daAPI para gerenciamento de consultas, exames e tratamentos veterinários.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "https://localhost:7232"
    },
    {
      "url": "http://localhost:5086"
    }
  ],
  "paths": {
    "/api/consulta": {
      "get": {
        "tags": [
          "Consultas"
        ],
        "summary": "Lista todas as consultas cadastradas.",
        "description": "Retorna consultas com dados do pet e do veterinário.",
        "responses": {
          "200": {
            "description": "Lista de consultas."
          }
        }
      },
      "post": {
        "tags": [
          "Consultas"
        ],
        "summary": "Registra uma nova consulta.",
        "description": "Exemplo de requisição:\r\n\r\n    POST /api/appointment\r\n    {\r\n        \"dtConsulta\": \"2026-05-20T10:00:00\",\r\n        \"tpEvento\": \"Consulta\",\r\n        \"notificar\": 1,\r\n        \"petId\": 1,\r\n        \"veterinarioId\": 1\r\n    }\r\n\r\nnotificar: 1 = sim, 0 = não\r\ntpEvento: Consulta de rotina, Consulta de Emergência, Retorno, Medicação",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Consulta criada com status 201."
          }
        }
      }
    },
    "/api/consulta/{id}": {
      "get": {
        "tags": [
          "Consultas"
        ],
        "summary": "Busca uma consulta pelo ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID da consulta.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Consulta encontrada ou 404."
          }
        }
      },
      "put": {
        "tags": [
          "Consultas"
        ],
        "summary": "Atualiza os dados de uma consulta.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID da consulta a ser atualizada.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/ConsultaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "204 em caso de sucesso ou 404 se não encontrado."
          }
        }
      },
      "delete": {
        "tags": [
          "Consultas"
        ],
        "summary": "Remove uma consulta pelo ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "ID da consulta a ser removida.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "204 em caso de sucesso ou 404 se não encontrado."
          }
        }
      }
    },
